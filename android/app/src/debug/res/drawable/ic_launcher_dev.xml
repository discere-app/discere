<?xml version="1.0" encoding="utf-8"?>
<!-- Dev-build launcher icon: tints the production icon and adds a corner
     badge so it's visually unmistakable next to the Play Store install on
     the home screen. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@mipmap/launcher_icon" />
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#59FF6D00" />
        </shape>
    </item>
    <item
        android:width="26dp"
        android:height="26dp"
        android:gravity="bottom|end">
        <shape android:shape="oval">
            <solid android:color="#FFFF6D00" />
            <stroke android:width="2dp" android:color="#FFFFFFFF" />
        </shape>
    </item>
</layer-list>
